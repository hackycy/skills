      "strategy": "replace-if-unmodified"
    },
    {
      "source": "project/.agents/scripts/verify_agent_notes.py",
      "target": ".agents/scripts/verify_agent_notes.py",
      "strategy": "replace-if-unmodified"
    },
    {
      "source": "project/.agents/scripts/new_agent_note.py",
      "target": ".agents/scripts/new_agent_note.py",
      "strategy": "replace-if-unmodified"
    },
    {
      "source": "project/.agents/scripts/archive_agent_note.py",
      "target": ".agents/scripts/archive_agent_note.py",
      "strategy": "replace-if-unmodified"
    },
    {
      "source": "project/.agents/scripts/governance_check.py",
      "target": ".agents/scripts/governance_check.py",
      "strategy": "replace-if-unmodified"
    },
    {
      "source": "project/.agents/skills/agent-note/agents/openai.yaml",
      "target": ".agents/skills/agent-note/agents/openai.yaml",
      "strategy": "replace-if-unmodified"
    },
    {
      "source": "project/.agents/skills/agent-note-maintenance/agents/openai.yaml",
      "target": ".agents/skills/agent-note-maintenance/agents/openai.yaml",
      "strategy": "replace-if-unmodified"
    },
    {
      "source": "project/.agents/skills/project-governance/agents/openai.yaml",
      "target": ".agents/skills/project-governance/agents/openai.yaml",
      "strategy": "replace-if-unmodified"
    },
    {
      "source": "project/.claude/skills/agent-note/SKILL.md",
      "target": ".claude/skills/agent-note/SKILL.md",
      "strategy": "replace-if-unmodified"
    },
    {
      "source": "project/.claude/skills/agent-note-maintenance/SKILL.md",
