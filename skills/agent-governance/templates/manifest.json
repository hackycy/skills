    {
      "source": "integrations/github-actions.yml",
      "target": ".github/workflows/agent-governance.yml",
      "strategy": "replace-if-unmodified",
      "optional": true,
      "integration": "github-actions"
    }
  ],
  "user_owned_globs": [
    ".agents/notes/proposed/*/*.md",
    ".agents/notes/implemented/*/*.md",
    ".agents/notes/rejected/*/*.md",
    ".agents/notes/archived/*/*.md"
  ],
  "user_owned_files": [
    ".agents/notes/archived/manifest.json"
  ],
  "note_classes": [
    "feature",
    "bug-fix",
    "simplification",
    "architecture",
    "process",
    "testing"
  ],
  "note_lifecycles": [
    "proposed",
    "implemented",
    "rejected",
    "archived"
  ]
}
