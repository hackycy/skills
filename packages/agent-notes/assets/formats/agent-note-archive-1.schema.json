{
  "type": "object",
  "properties": {
    "format": {
      "const": "agent-note-archive/1"
    },
    "entries": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^an-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^archived/(?:feature|bug-fix|simplification|architecture|process|testing)/\\d{4}-\\d{2}-\\d{2}-[^/\\\\]+\\.md$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^implemented/(?:feature|bug-fix|simplification|architecture|process|testing)/\\d{4}-\\d{2}-\\d{2}-[^/\\\\]+\\.md$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "revision": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "path",
          "sha256",
          "source"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "entries"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Note archive v1 manifest"
}
