{
  "name": "@hackycy/agent-notes",
  "type": "module",
  "version": "0.0.0",
  "description": "Portable engineering decision notes with explicit lifecycle governance",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackycy/skills.git",
    "directory": "packages/agent-notes"
  },
  "bin": { "agent-notes": "./dist/cli.mjs" },
  "files": ["assets", "dist", "docs/installation.md"],
