    "test:install": "tsx tests/install-smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@clack/prompts": "catalog:",
    "@types/mdast": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
